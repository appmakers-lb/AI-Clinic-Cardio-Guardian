{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Clinic Cardio Guardian Structured Research Finding Package",
  "type": "object",
  "required": [
    "modelId",
    "modelVersion",
    "findings"
  ],
  "properties": {
    "modelId": {
      "type": "string",
      "minLength": 1
    },
    "modelVersion": {
      "type": "string",
      "minLength": 1
    },
    "caseId": {
      "type": [
        "string",
        "null"
      ]
    },
    "generatedAtUtc": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "vessel",
          "segment",
          "findingType",
          "confidence",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "vessel": {
            "type": "string"
          },
          "segment": {
            "type": "string"
          },
          "findingType": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "priority": {
            "enum": [
              "Silent",
              "Information",
              "Review",
              "HighPriorityReview"
            ]
          },
          "explanation": {
            "type": "string"
          },
          "measurementSummary": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "sourceId",
                "description"
              ],
              "properties": {
                "sourceId": {
                  "type": "string"
                },
                "frameStart": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "frameEnd": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "projection": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "description": {
                  "type": "string"
                },
                "normalizedCenterX": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1
                },
                "normalizedCenterY": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1
                },
                "normalizedRadius": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "exclusiveMinimum": 0,
                  "maximum": 1
                }
              }
            }
          },
          "estimatedDiameterStenosisPercent": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "estimatedDiameterStenosisLowerPercent": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "estimatedDiameterStenosisUpperPercent": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "referenceDiameterPixels": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "minimumLumenDiameterPixels": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "lesionLengthPixels": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "referenceDiameterMm": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "minimumLumenDiameterMm": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "lesionLengthMm": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "measurementQuality": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "Limited",
              "Moderate",
              "High",
              null
            ]
          },
          "measurementQualityScore": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "measurementFrameCount": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "measurementVariabilityPercent": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "calibrationSource": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "vessel",
          "segment",
          "state",
          "evidence"
        ],
        "properties": {
          "vessel": {
            "type": "string",
            "minLength": 1
          },
          "segment": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "Adequate",
              "Partial",
              "Incomplete"
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "sourceId",
                "description"
              ],
              "properties": {
                "sourceId": {
                  "type": "string",
                  "minLength": 1
                },
                "frameStart": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "frameEnd": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "projection": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "description": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
