<Window x:Class="AIClinic.CardioGuardian.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Clinic Cardio Guardian — Research v1.2.1"
        Height="900" Width="1440" MinHeight="680" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ResizeMode="CanResizeWithGrip"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel LastChildFill="True">
        <!-- Research-mode banner -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Danger}" Padding="8">
            <Grid>
                <TextBlock HorizontalAlignment="Center" FontSize="15" FontWeight="Bold"
                           Text="RESEARCH AI DEMO — NOT FOR CLINICAL DECISIONS"/>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="12" FontWeight="SemiBold" Text="v1.2.1"/>
            </Grid>
        </Border>

        <!-- Responsive two-row toolbar -->
        <Border DockPanel.Dock="Top" Background="#111B27"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                        <Button Style="{StaticResource PrimaryButton}"
                                Content="1  IMPORT CARDIAC CD / USB / DICOM"
                                Click="ImportDicom_Click" MinWidth="260"/>
                        <Button Content="OPEN VIDEO" Click="OpenCine_Click" MinWidth="120"/>
                        <Button Content="CLEAR CASE" Click="ClearCase_Click" MinWidth="105"/>
                    </WrapPanel>

                    <Border Grid.Column="1" Background="#172231" BorderBrush="{StaticResource Border}"
                            BorderThickness="1" CornerRadius="5" Padding="10,7" Margin="8,4,0,4">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" Fill="#F59E0B" Margin="0,0,8,0"/>
                            <TextBlock x:Name="ModelStatusText"
                                       Text="Research AI model: NOT CONNECTED"
                                       FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <WrapPanel Grid.Row="1" Margin="0,2,0,0">
                    <Button Content="IMPORT AI FINDINGS JSON" Click="ImportFindings_Click" MinWidth="185"
                            ToolTip="Imports structured, versioned research-model output. It does not create findings from raw images by itself."/>
                    <Button Content="CONNECT LOCAL AI" Click="ConnectLocalAi_Click" MinWidth="145"/>
                    <Button x:Name="AnalyzeButton" Content="RUN RESEARCH AI ON SELECTED CINE"
                            Click="AnalyzeSelectedCine_Click" MinWidth="200" IsEnabled="False"/>
                    <Button x:Name="AnalyzeWholeCaseButton" Content="RUN RESEARCH AI WHOLE CASE"
                            Click="AnalyzeWholeCase_Click" MinWidth="175" IsEnabled="False"
                            ToolTip="Runs the connected research model across every imported cine series. Batch mode does not speak alerts while processing."/>
                    <Button x:Name="CancelAnalysisButton" Content="CANCEL ANALYSIS"
                            Click="CancelAnalysis_Click" MinWidth="135" IsEnabled="False"
                            ToolTip="Stops the current research-model request/batch. Findings already accepted remain in the case."/>
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"
                               Text="Start: import the whole cardiac CD/USB → select a cine → LOAD SELECTED CINE."/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Bottom status bar -->
        <Border DockPanel.Dock="Bottom" Background="#0E151E"
                BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           Text="Ready — import a cardiac DICOM CD/USB or open a research video."
                           Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="FrameStatusText" Grid.Column="1" Margin="10,0,0,0"
                           Foreground="#93C5FD" FontWeight="SemiBold"/>
            </Grid>
        </Border>

        <!-- Main application area -->
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="205"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="340" MinWidth="275"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: DICOM navigation. Vertical scrolling only; no horizontal clipping. -->
            <Border Grid.Column="0" Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Border}" BorderThickness="1"
                    CornerRadius="6" Padding="9">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="125"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="CASE / DICOM NAVIGATOR" FontWeight="Bold" FontSize="14" Foreground="#93C5FD"/>
                        <TextBlock Text="All cine runs from the imported study stay together in one case."
                                   TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,4,0,8"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="#0E151E" BorderBrush="{StaticResource Border}"
                            BorderThickness="1" CornerRadius="4" Padding="7" Margin="0,0,0,8">
                        <TextBlock x:Name="PatientStudyText" Text="No DICOM study loaded."
                                   TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
                    </Border>

                    <ListBox x:Name="SeriesList" Grid.Row="2" SelectionChanged="SeriesList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="3">
                                    <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                    <TextBlock Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis">
                                        <Run Text="ID: "/><Run Text="{Binding Id}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="3" Margin="0,8,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" Style="{StaticResource PrimaryButton}"
                                Content="LOAD SELECTED CINE" Click="LoadSelectedSeries_Click"
                                HorizontalAlignment="Stretch"/>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="◀ PREVIOUS CINE" Click="PreviousCine_Click"/>
                            <Button Grid.Column="1" Content="NEXT CINE ▶" Click="NextCine_Click"/>
                        </Grid>
                    </Grid>

                    <GroupBox Grid.Row="4" Header="Whole-Case Runs" Margin="0">
                        <ListBox x:Name="CaseRunsList" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                    </GroupBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          Background="#253244" ShowsPreview="True"/>

            <!-- CENTER: large viewer -->
            <Grid Grid.Column="2" Margin="8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#030609" BorderBrush="{StaticResource Border}"
                        BorderThickness="1" CornerRadius="6" MinHeight="300" ClipToBounds="True">
                    <Grid>
                        <Grid x:Name="ImageSurface">
                            <MediaElement x:Name="CinePlayer" Stretch="Uniform"
                                          MediaOpened="CinePlayer_MediaOpened"
                                          MediaEnded="CinePlayer_MediaEnded"
                                          Visibility="Collapsed"/>
                            <Image x:Name="DicomFrameImage" Stretch="Uniform" Visibility="Collapsed"/>
                            <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False"/>
                        </Grid>

                        <StackPanel x:Name="ViewerPlaceholder" HorizontalAlignment="Center"
                                    VerticalAlignment="Center" MaxWidth="520" Margin="20">
                            <TextBlock Text="Import a cardiac CD / USB / DICOM folder"
                                       HorizontalAlignment="Center" TextAlignment="Center"
                                       FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="The cine viewer opens here. DICOM studies stay local on this workstation."
                                       Foreground="{StaticResource Muted}" HorizontalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap" FontSize="14" Margin="0,8,0,0"/>
                        </StackPanel>

                        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                Background="#D90B1017" Margin="10" Padding="9,6" CornerRadius="4"
                                MaxWidth="420">
                            <StackPanel>
                                <TextBlock x:Name="ViewerSourceText" Text="No source loaded"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ProjectionText" Text="" Foreground="{StaticResource Muted}"
                                           FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Slider x:Name="Timeline" Grid.Row="1" Margin="0,8,0,4"
                        Minimum="0" Maximum="1" Value="0" IsEnabled="False"/>

                <UniformGrid Grid.Row="2" Rows="2" Columns="3" Margin="0,2,0,0">
                    <Button x:Name="PrevFrameButton" Content="◀ FRAME" Click="PrevFrame_Click" IsEnabled="False"/>
                    <Button x:Name="PlayButton" Style="{StaticResource PrimaryButton}" Content="▶ PLAY"
                            Click="PlayPause_Click" IsEnabled="False"/>
                    <Button x:Name="NextFrameButton" Content="FRAME ▶" Click="NextFrame_Click" IsEnabled="False"/>
                    <Button x:Name="StopButton" Content="■ STOP" Click="Stop_Click" IsEnabled="False"/>
                    <Button Content="ADD MANUAL RESEARCH FINDING" Click="AddManualFinding_Click"
                            ToolTip="Adds a human research annotation at the current frame. It is explicitly NOT an AI finding."/>
                    <Button Content="SHOW EVIDENCE" Click="ShowEvidence_Click"/>
                </UniformGrid>

                <Border Grid.Row="3" Background="#111B27" BorderBrush="{StaticResource Border}"
                        BorderThickness="1" CornerRadius="5" Padding="7" Margin="0,7,0,0">
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11">
                        <Run FontWeight="Bold" Foreground="#FDE68A" Text="Research build: "/>
                        <Run Text="v1.2.1 requires direct stenosis localization plus vessel support and temporal persistence before showing a candidate. Apparent diameter reduction is a wide-range uncalibrated research estimate, not clinical QCA; complete occlusion and artery identity are not inferred."/>
                    </TextBlock>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch"
                          Background="#253244" ShowsPreview="True"/>

            <!-- RIGHT: tabbed workspace keeps every control visible without a tall stacked sidebar. -->
            <Border Grid.Column="4" Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Border}" BorderThickness="1"
                    CornerRadius="6" Padding="7">
                <TabControl>
                    <TabItem Header="Guardian">
                        <Grid Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ListBox x:Name="FindingList" Grid.Row="0" MinHeight="150"
                                     SelectionChanged="FindingList_SelectionChanged"
                                     MouseDoubleClick="FindingList_MouseDoubleClick"
                                     ToolTip="Double-click a finding to focus the evidence region. Press Esc to return to the full cine."
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                            <TextBlock x:Name="FindingDetailText" Grid.Row="1"
                                       Text="No structured findings loaded."
                                       TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                                       Margin="3,7,3,5"/>
                            <UniformGrid Grid.Row="2" Rows="1" Columns="3">
                                <Button Content="CONFIRM" Click="ConfirmFinding_Click"/>
                                <Button Content="DISMISS" Click="DismissFinding_Click"/>
                                <Button Content="SHOW WHY" Click="ShowEvidence_Click"/>
                            </UniformGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Coverage">
                        <Grid Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ListBox x:Name="CoverageList" Grid.Row="0" MinHeight="180"
                                     SelectionChanged="CoverageList_SelectionChanged"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                            <Grid Grid.Row="1" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="CoverageChoice" Grid.Column="0" SelectedIndex="0" Margin="3">
                                    <ComboBoxItem Content="Unassessed"/>
                                    <ComboBoxItem Content="Adequate"/>
                                    <ComboBoxItem Content="Partial"/>
                                    <ComboBoxItem Content="Incomplete"/>
                                </ComboBox>
                                <Button Grid.Column="1" Content="SET" Click="SetCoverage_Click"/>
                                <Button Grid.Column="2" Content="SUMMARY" Click="CoverageSummary_Click"/>
                            </Grid>
                            <TextBlock x:Name="CoverageSummaryText" Grid.Row="2"
                                       TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                                       Margin="4,7,4,0"/>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Copilot">
                        <Grid Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBox x:Name="ChatLog" Grid.Row="0" MinHeight="180" IsReadOnly="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                            <TextBox x:Name="QuestionBox" Grid.Row="1" Height="40" Margin="0,7,0,0"
                                     VerticalContentAlignment="Center" KeyDown="QuestionBox_KeyDown"/>
                            <UniformGrid Grid.Row="2" Rows="2" Columns="2" Margin="0,4,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="ASK" Click="Ask_Click"/>
                                <Button Content="SHOW WHY" Click="ShowEvidence_Click"/>
                                <Button Content="WHAT'S INCOMPLETE?" Click="CoverageSummary_Click"/>
                                <Button x:Name="ListenButton" Content="🎙 LISTEN" Click="Listen_Click"/>
                            </UniformGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Voice / System">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="6">
                                <TextBlock Text="VOICE" FontWeight="Bold" Foreground="#93C5FD" Margin="0,0,0,5"/>
                                <CheckBox x:Name="VoiceEnabled"
                                          Content="Speak high-priority research candidate alerts"
                                          IsChecked="True"
                                          Margin="4" Checked="VoiceEnabled_Changed" Unchecked="VoiceEnabled_Changed"/>
                                <TextBlock x:Name="VoiceStatusText" Foreground="{StaticResource Muted}"
                                           TextWrapping="Wrap" Margin="4,2,4,10"/>
                                <Separator Margin="0,5"/>
                                <TextBlock Text="SYSTEM / AUDIT" FontWeight="Bold" Foreground="#93C5FD" Margin="0,5,0,5"/>
                                <TextBlock x:Name="AuditPathText" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="ImportSummaryText" Foreground="{StaticResource Muted}"
                                           TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </DockPanel>
</Window>
